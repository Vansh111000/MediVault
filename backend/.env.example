PORT=5001
MONGO_URI=your_mongodb_connection_string
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Keep the real key in backend/.env or your server's secret manager. Never expose it in frontend variables.
GEMINI_API_KEY=replace_with_a_rotated_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=90000
